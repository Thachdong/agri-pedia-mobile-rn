# Copy to .env. Android emulator reaches the host machine via 10.0.2.2; a physical device (Expo Go) needs the Mac LAN IP (`ipconfig getifaddr en0`), never localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
