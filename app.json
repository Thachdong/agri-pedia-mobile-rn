{
  "expo": {
    "name": "AgriPedia",
    "slug": "agripedia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agripedia",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriPedia dùng vị trí của bạn để chọn địa chỉ trên bản đồ và tìm nhà phân phối gần bạn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriPedia dùng thư viện ảnh để bạn chọn ảnh đại diện, giấy phép kinh doanh và ảnh cây trồng cần chẩn đoán.",
          "cameraPermission": "AgriPedia dùng camera để bạn chụp ảnh cây trồng cần chẩn đoán bệnh.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
